{
  "name": "build-sprint-app",
  "version": "1.0.0",
  "description": "Landing page for a local appliance comparison assistant",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
